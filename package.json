{
  "name": "project-dashboard",
  "version": "1.0.0",
  "description": "داشبورد مدیریت پروژه با SQLite و React",
  "scripts": {
    "dev:server": "tsx server/index.ts",
    "dev:server:watch": "tsx watch server/index.ts",
    "dev:web": "cd web && vite",
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server:watch\" \"npm:dev:web\"",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "cd web && vite build",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/server/index.js",
    "type-check": "tsc -p server/tsconfig.json --noEmit && cd web && tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --watchAll=false"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "express": "^4.18.2",
    "jalaliday": "^1.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.11.2",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "concurrently": "^8.2.2",
    "jest": "^30.2.0",
    "lucide-react": "^0.294.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.8.0",
    "supertest": "^7.1.4",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.3.6",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^5.0.8",
    "webpack-cli": "^6.0.1"
  }
}
